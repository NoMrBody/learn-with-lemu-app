# Copy this file to .env.local and fill in the values below.
# .env.local is gitignored — never commit real keys.
#
# Get both values from: Supabase dashboard -> your project -> Project Settings -> API

# "Project URL" on the API settings page.
NEXT_PUBLIC_SUPABASE_URL=

# "anon / public" key on the API settings page. Safe to expose to the
# browser — access is governed by Row Level Security, not by keeping this
# secret. Do NOT put the service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
